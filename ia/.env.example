# Configurações do OCI Object Storage (app/main.py busca vectorizer.joblib e modelo.joblib)
OCI_BUCKET_NAME=techknowledge-models
OCI_NAMESPACE=idxxxxxxx  # Substitua pelo seu namespace OCI (ex: id6g3h7k)
OCI_REGION=us-ashburn-1   # Região do OCI Object Storage (ex: us-ashburn-1, sa-saopaulo-1)

# URL e porta (para uso interno)
PORT=8000